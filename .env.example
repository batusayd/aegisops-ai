# ==============================================================================
# OMNICHANNEL AI OPERATIONS & SUPPORT HUB — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Application Runtime ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- LLM API Credentials (LiteLLM Unified Router) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Enable deterministic intelligent fallback when running live demos without API keys
DEMO_MOCK_LLM_FALLBACK=true

# --- Model Routing Configuration ---
# Fast/Cheap tier for Intent Classification, Urgency Triage, Toxicity & Sliding-Window Translation
FAST_ROUTER_MODEL=gpt-4o-mini
# Reasoning tier for Cited RAG Response Drafting & Daily Executive Community Digests
REASONING_DRAFT_MODEL=gpt-4o
# Vector Embedding Model (with local deterministic hash/fastembed fallback if offline)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Baseline Comparison Model (For "Cost & Latency Saved vs. Single-Model" UI Metric) ---
BASELINE_SINGLE_MODEL=gpt-4o

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omnichannel_kb_v1
SEED_DIR=../seed
AUTO_INGEST_SEED_ON_STARTUP=true

# --- Workflow A: Smart Human-in-the-Loop (HITL) & Cryptographic Action Tokens ---
# Drafts with confidence < threshold OR urgency == "HIGH" trigger Mandatory Human Review
HITL_CONFIDENCE_THRESHOLD=0.75
HITL_AUTO_APPROVE_ENABLED=false
HITL_ACTION_TOKEN_SECRET=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e
HITL_TOKEN_EXPIRY_MINUTES=1440

# --- Workflow B: Multilingual Community Chat & Moderation ---
SUPPORTED_LANGUAGES=EN,PL,TR
CHAT_SLIDING_WINDOW_SIZE=5
CHAT_TOXICITY_THRESHOLD=0.70
DIGEST_CRON_HOUR=18
DIGEST_CRON_MINUTE=0

# --- Frontend Public Environment Variables ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
